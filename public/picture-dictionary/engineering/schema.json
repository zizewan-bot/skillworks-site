{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillworks.dev/picture-dictionary/engineering/schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "updated_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "const": "picture-dictionary-kids"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
